{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.skill-eval.runtime-capabilities.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "models", "defaultModelId", "features", "limits"],
  "properties": {
    "schemaVersion": { "const": "finance.skill-eval.runtime-capabilities.v1" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelId", "upstreamModelId"],
        "properties": {
          "modelId": { "type": "string", "minLength": 1 },
          "upstreamModelId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaultModelId": { "type": "string", "minLength": 1 },
    "supportedSkillModes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["skill_version", "without_target_skill"] }
    },
    "nativeToolNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nativeCapabilities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["capabilityId", "name", "contract", "constraints"],
        "properties": {
          "capabilityId": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "contract": {"type": "object", "additionalProperties": false, "required": ["inputSchema", "outputSchema", "errorSchema", "semantics"], "properties": {
            "inputSchema": {"type": "object"}, "outputSchema": {"type": "object"}, "errorSchema": {"type": "object"}, "semantics": {"type": "string", "minLength": 1}
          }},
          "constraints": {"type": "object", "additionalProperties": false, "required": ["permissions", "sideEffects", "isolation"], "properties": {
            "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "sideEffects": {"enum": ["none", "read", "write"]}, "isolation": {"type": "string", "minLength": 1}
          }}
        }
      }
    },
    "observability": { "$ref": "finance.runtime-observation-capabilities.v1" },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streaming", "asyncLaunch", "packagedMcp", "externalMcp", "inlineSecrets"],
      "properties": {
        "streaming": { "type": "boolean" },
        "asyncLaunch": { "type": "boolean" },
        "packagedMcp": { "type": "boolean" },
        "externalMcp": { "type": "boolean" },
        "inlineSecrets": { "type": "boolean" },
        "multiTurn": { "type": "boolean", "description": "Distinct native Agent invocations in one isolated case, retaining session, workspace and MCP lifecycle; omitted means unsupported." }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxArchiveBytes", "maxFiles", "maxTimeoutMs", "maxConcurrentInstances"],
      "properties": {
        "maxArchiveBytes": { "type": "integer", "minimum": 1 },
        "maxFiles": { "type": "integer", "minimum": 1 },
        "maxTimeoutMs": { "type": "integer", "minimum": 1 },
        "maxConcurrentInstances": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
