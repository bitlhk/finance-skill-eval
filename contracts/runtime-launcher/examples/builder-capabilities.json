{
  "schemaVersion": "finance.runtime-capabilities.v1",
  "runtime": {
    "type": "openjiuwen",
    "version": "1.2.0"
  },
  "models": [
    {
      "modelId": "execution",
      "upstreamModelId": "glm-4-plus",
      "label": "GLM 4 Plus"
    }
  ],
  "defaultModelId": "execution",
  "nativeToolNames": [
    "mcp.call",
    "read_document"
  ],
  "observability": {
    "schemaVersion": "finance.runtime-observation-capabilities.v1",
    "profile": "tool",
    "supportedKinds": [
      "execution.started",
      "execution.completed",
      "execution.failed",
      "model.call.started",
      "model.call.completed",
      "model.call.failed",
      "tool.call.started",
      "tool.call.completed",
      "tool.call.failed"
    ],
    "nativeEvents": false,
    "replayable": false
  },
  "features": {
    "streaming": true,
    "asyncLaunch": true,
    "packagedMcp": true,
    "externalMcp": false,
    "inlineSecrets": true
  },
  "limits": {
    "maxArchiveBytes": 8388608,
    "maxFiles": 1000,
    "maxTimeoutMs": 300000,
    "maxConcurrentInstances": 4,
    "maxSkills": 10
  },
  "instanceSchemaVersion": "finance.runtime-instance.v1",
  "platform": {
    "os": "linux",
    "arch": "x64",
    "isolation": "trusted_local_process"
  },
  "nativeCapabilities": [
    {
      "capabilityId": "read_document",
      "name": "read_document",
      "contract": {
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object"
        },
        "errorSchema": {
          "type": "object"
        },
        "semantics": "只允许读取当前隔离工作区内的文件"
      },
      "constraints": {
        "permissions": [
          "workspace.read"
        ],
        "sideEffects": "read",
        "isolation": "per_runtime_instance"
      }
    }
  ]
}
