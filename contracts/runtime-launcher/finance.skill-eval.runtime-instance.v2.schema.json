{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.skill-eval.runtime-instance.v2",
  "title": "Frozen multi-Skill instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "side", "modelId", "variant", "skill", "bundle", "environment", "configuration", "secrets", "limits"],
  "properties": {
    "schemaVersion": {"const": "finance.skill-eval.runtime-instance.v2"},
    "runId": {"type": "string", "minLength": 1},
    "side": {"enum": ["left", "right"]},
    "modelId": {"type": "string", "minLength": 1},
    "variant": {"$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/variant"},
    "skill": {"type": "null"},
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "members", "archiveBase64", "archiveSha256"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "archiveBase64": {"type": "string", "contentEncoding": "base64"},
        "archiveSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "entryInstructionsFile": {"type": "string", "minLength": 1},
        "members": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "skillId", "version", "artifactSha256", "skillFile"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "skillId": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "artifactSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "skillFile": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "environment": {"$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/$defs/environment"},
    "configuration": {"$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/configuration"},
    "secrets": {"$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/secrets"},
    "limits": {"$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/limits"},
    "generation": {"$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/generation"}
  }
}
