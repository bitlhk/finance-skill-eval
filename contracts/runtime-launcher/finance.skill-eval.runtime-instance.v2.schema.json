{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.skill-eval.runtime-instance.v2",
  "title": "One or more inline Skills with optional resources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "side",
    "modelId",
    "environment",
    "configuration",
    "secrets",
    "limits",
    "skills",
    "contentDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "finance.skill-eval.runtime-instance.v2"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "enum": [
        "left",
        "right"
      ]
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/$defs/environment"
    },
    "configuration": {
      "$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/configuration"
    },
    "secrets": {
      "$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/secrets"
    },
    "limits": {
      "$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/limits"
    },
    "generation": {
      "$ref": "finance.skill-eval.runtime-instance.v1.schema.json#/properties/generation"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skillId",
          "version",
          "artifactSha256",
          "skillFile",
          "instructions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "skillId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "skillFile": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "maxProperties": 1000,
            "additionalProperties": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "maxProperties": 1000,
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      }
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entryInstructionsFile": {
      "type": "string",
      "minLength": 1
    }
  }
}
