{
  "$ref": "#/definitions/manual_preparation",
  "definitions": {
    "manual_preparation": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stateFixture": {
                "type": "object",
                "properties": {
                  "fixtureId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "initialStateDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "fixtureId",
                  "version",
                  "initialStateDigest"
                ],
                "additionalProperties": false
              },
              "evaluationPlan": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "answerEvidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                        },
                        "reference": {
                          "type": "string",
                          "maxLength": 300,
                          "pattern": "^\\/(state\\/.+|toolEvidence\\/\\d+\\/result\\/.+)$"
                        }
                      },
                      "required": [
                        "id",
                        "reference"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 32
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "RULE",
                            "SCRIPT",
                            "STATE"
                          ]
                        },
                        "required": {
                          "type": "boolean",
                          "default": true
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "maxItems": 32,
                          "default": []
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 120000,
                          "default": 60000
                        },
                        "rule": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string",
                                  "const": "equals"
                                },
                                "reference": {
                                  "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationPlan/properties/checks/items/properties/evidenceRefs/items"
                                },
                                "expected": {}
                              },
                              "required": [
                                "operation",
                                "reference"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string",
                                  "const": "contains"
                                },
                                "reference": {
                                  "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationPlan/properties/checks/items/properties/evidenceRefs/items"
                                },
                                "expected": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operation",
                                "reference",
                                "expected"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string",
                                  "const": "exists"
                                },
                                "reference": {
                                  "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationPlan/properties/checks/items/properties/evidenceRefs/items"
                                }
                              },
                              "required": [
                                "operation",
                                "reference"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string",
                                  "const": "numeric_tolerance"
                                },
                                "reference": {
                                  "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationPlan/properties/checks/items/properties/evidenceRefs/items"
                                },
                                "expected": {
                                  "type": "number"
                                },
                                "absoluteTolerance": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "relativeTolerance": {
                                  "type": "number",
                                  "minimum": 0,
                                  "default": 0
                                }
                              },
                              "required": [
                                "operation",
                                "reference",
                                "expected",
                                "absoluteTolerance"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operation": {
                                  "type": "string",
                                  "const": "set_equals"
                                },
                                "reference": {
                                  "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationPlan/properties/checks/items/properties/evidenceRefs/items"
                                },
                                "expected": {
                                  "type": "array",
                                  "items": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "boolean"
                                      }
                                    ]
                                  },
                                  "maxItems": 1000
                                }
                              },
                              "required": [
                                "operation",
                                "reference",
                                "expected"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "script": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32000
                        }
                      },
                      "required": [
                        "id",
                        "version",
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "version",
                  "checks"
                ],
                "additionalProperties": false
              },
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "taskMode": {
                "type": "string",
                "enum": [
                  "single_turn",
                  "multi_turn"
                ],
                "default": "single_turn"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "evaluationGoal": {
                "type": "string",
                "minLength": 1
              },
              "requiredTools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "workspaceFiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 262144
                    }
                  },
                  "required": [
                    "path",
                    "content"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 32
              },
              "turns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "requiredTools": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "maxItems": 32,
                      "default": []
                    }
                  },
                  "required": [
                    "query"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 8
              },
              "toolExpectations": {
                "type": "object",
                "properties": {
                  "mustSucceed": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "mustNotCall": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": []
                  }
                },
                "required": [
                  "mustSucceed"
                ],
                "additionalProperties": false
              },
              "rubric": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scope": {
                      "type": "string",
                      "enum": [
                        "answer",
                        "execution"
                      ]
                    },
                    "criterionId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dimension": {
                      "type": "string",
                      "enum": [
                        "professional_fit",
                        "business_completeness",
                        "clarity",
                        "actionability"
                      ]
                    },
                    "weight": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "required": {
                      "type": "boolean",
                      "default": false
                    },
                    "allOf": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "default": []
                    },
                    "anyOf": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "default": []
                    },
                    "noneOf": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "default": []
                    },
                    "improvementHint": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "criterionId",
                    "label",
                    "description",
                    "dimension",
                    "weight"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "caseId",
              "name",
              "prompt",
              "evaluationGoal",
              "rubric"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        },
        "holdoutCases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stateFixture": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/stateFixture"
              },
              "evaluationPlan": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationPlan"
              },
              "caseId": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/caseId"
              },
              "name": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/name"
              },
              "taskMode": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/taskMode"
              },
              "prompt": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/prompt"
              },
              "evaluationGoal": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/evaluationGoal"
              },
              "requiredTools": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/requiredTools"
              },
              "workspaceFiles": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/workspaceFiles"
              },
              "turns": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/turns"
              },
              "toolExpectations": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/toolExpectations"
              },
              "rubric": {
                "$ref": "#/definitions/manual_preparation/properties/cases/items/properties/rubric"
              }
            },
            "required": [
              "caseId",
              "name",
              "prompt",
              "evaluationGoal",
              "rubric"
            ],
            "additionalProperties": false
          },
          "maxItems": 100,
          "default": []
        }
      },
      "required": [
        "summary",
        "cases"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
