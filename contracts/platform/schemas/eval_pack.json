{
  "$ref": "#/definitions/eval_pack",
  "definitions": {
    "eval_pack": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "finance.skill-eval.pack.v1"
        },
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "targetSkillId": {
          "type": "string",
          "minLength": 1
        },
        "targetSkillVersion": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "object",
          "properties": {
            "analyzer": {
              "type": "object",
              "properties": {
                "providerId": {
                  "type": "string",
                  "minLength": 1
                },
                "modelId": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "credentialRef": {
                  "type": "string",
                  "minLength": 1
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "disabled"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "default": {}
                }
              },
              "required": [
                "providerId",
                "modelId"
              ],
              "additionalProperties": false
            },
            "execution": {
              "type": "object",
              "properties": {
                "left": {
                  "$ref": "#/definitions/eval_pack/properties/models/properties/analyzer"
                },
                "right": {
                  "$ref": "#/definitions/eval_pack/properties/models/properties/analyzer"
                }
              },
              "required": [
                "left",
                "right"
              ],
              "additionalProperties": false
            },
            "judge": {
              "$ref": "#/definitions/eval_pack/properties/models/properties/analyzer"
            }
          },
          "required": [
            "analyzer",
            "execution",
            "judge"
          ],
          "additionalProperties": false
        },
        "variants": {
          "type": "object",
          "properties": {
            "left": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "without_target_skill"
                    },
                    "skillId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "mode",
                    "skillId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "skill_version"
                    },
                    "skillId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifactSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "mode",
                    "skillId",
                    "version"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "right": {
              "$ref": "#/definitions/eval_pack/properties/variants/properties/left"
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        "judgeProfileFile": {
          "type": "string",
          "minLength": 1
        },
        "caseFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "holdoutCaseFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "schemaVersion",
        "packId",
        "version",
        "domain",
        "targetSkillId",
        "targetSkillVersion",
        "description",
        "models",
        "variants",
        "judgeProfileFile",
        "caseFiles"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
