{
  "$ref": "#/definitions/create_task",
  "definitions": {
    "create_task": {
      "type": "object",
      "properties": {
        "inputKind": {
          "type": "string",
          "enum": [
            "skill_package",
            "agent_project"
          ],
          "default": "skill_package"
        },
        "projectNotes": {
          "type": "string",
          "maxLength": 8000,
          "default": ""
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "default": ""
        },
        "goal": {
          "type": "string",
          "maxLength": 8000,
          "default": ""
        },
        "target": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        },
        "configuration": {
          "type": "object",
          "properties": {
            "executionMode": {
              "type": "string",
              "enum": [
                "agent_project"
              ]
            },
            "runtimeInputs": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "maxLength": 8000
                      }
                    },
                    "required": [
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "secretEnv": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
                      }
                    },
                    "required": [
                      "secretEnv"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "runtimeToolConfig": {
              "type": "object",
              "properties": {
                "context": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "string",
                          "object",
                          "array",
                          "number",
                          "boolean"
                        ]
                      },
                      "value": {},
                      "env": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sensitive": {
                        "type": "boolean",
                        "default": true
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "default": {}
                },
                "providers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "implementation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "inputs": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^context\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                        }
                      }
                    },
                    "required": [
                      "implementation",
                      "inputs"
                    ],
                    "additionalProperties": false
                  },
                  "default": {}
                },
                "tools": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "contextBindings": {
                        "type": "object",
                        "additionalProperties": {
                          "$ref": "#/definitions/create_task/properties/configuration/properties/runtimeToolConfig/properties/providers/additionalProperties/properties/inputs/additionalProperties"
                        },
                        "default": {}
                      },
                      "authProvider": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "default": {}
                }
              },
              "additionalProperties": false
            },
            "environmentId": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 10000,
              "maximum": 900000,
              "default": 310000
            },
            "entryInstructionsFile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "harnessTools": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read_file",
                  "glob",
                  "list_files",
                  "bash"
                ]
              },
              "maxItems": 4,
              "default": [
                "read_file",
                "glob",
                "list_files"
              ]
            }
          },
          "required": [
            "environmentId",
            "modelId"
          ],
          "additionalProperties": false
        },
        "sourceAssetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "sourceAssetIds"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
