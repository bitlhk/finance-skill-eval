{
  "$ref": "#/definitions/launcher_delivery",
  "definitions": {
    "launcher_delivery": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "finance.runtime-launcher-delivery-record.v1"
        },
        "buildId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "requirementsDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilitiesDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "builder": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evalConformance": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "PASSED"
            },
            "testedAt": {
              "type": "string",
              "format": "date-time"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "instanceSchemaVersion": {
              "type": "string",
              "const": "finance.runtime-instance.v1"
            },
            "probeDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "checks": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": [
                {
                  "type": "string",
                  "const": "capabilities"
                },
                {
                  "type": "string",
                  "const": "create"
                },
                {
                  "type": "string",
                  "const": "status"
                },
                {
                  "type": "string",
                  "const": "execute"
                },
                {
                  "type": "string",
                  "const": "evidence"
                },
                {
                  "type": "string",
                  "const": "delete"
                }
              ]
            },
            "probeKind": {
              "type": "string",
              "enum": [
                "WORKSPACE_FILE_READ",
                "MANAGED_METHOD_INSTRUCTION_NONCE"
              ]
            }
          },
          "required": [
            "status",
            "testedAt",
            "runId",
            "instanceSchemaVersion",
            "probeDigest",
            "checks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "buildId",
        "requestId",
        "deploymentId",
        "artifactSha256",
        "capabilitiesDigest",
        "resultDigest",
        "builder",
        "acceptedAt",
        "expiresAt",
        "evalConformance"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
