{
  "$ref": "#/definitions/judge_result",
  "definitions": {
    "judge_result": {
      "type": "object",
      "properties": {
        "runtimeComparison": {
          "type": "object",
          "properties": {
            "left": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "assessed"
                    },
                    "assessment": {
                      "type": "object",
                      "properties": {
                        "verdict": {
                          "type": "string",
                          "enum": [
                            "PASS",
                            "FAIL",
                            "INDETERMINATE"
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "checks": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "criterion": {
                                "type": "string",
                                "minLength": 1
                              },
                              "verdict": {
                                "type": "string",
                                "enum": [
                                  "PASS",
                                  "FAIL",
                                  "INDETERMINATE"
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1
                              },
                              "evidence": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "criterion",
                              "verdict",
                              "reason",
                              "evidence"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "verdict",
                        "reason",
                        "checks"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "assessment"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "unavailable"
                    },
                    "error": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "right": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "assessed"
                    },
                    "assessment": {
                      "$ref": "#/definitions/judge_result/properties/runtimeComparison/properties/left/anyOf/0/properties/assessment"
                    }
                  },
                  "required": [
                    "status",
                    "assessment"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "unavailable"
                    },
                    "error": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        "serviceComparison": {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "FAIL",
                      "INDETERMINATE"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "originalEvidence": {
                    "type": "string"
                  },
                  "candidateEvidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "criterion",
                  "verdict",
                  "reason",
                  "originalEvidence",
                  "candidateEvidence"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "verdict",
            "reason",
            "checks"
          ],
          "additionalProperties": false
        },
        "goalAssessment": {
          "$ref": "#/definitions/judge_result/properties/runtimeComparison/properties/left/anyOf/0/properties/assessment"
        },
        "winner": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "tie"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "professional_fit",
                  "business_completeness",
                  "clarity",
                  "actionability"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "leftScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "rightScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label",
              "leftScore",
              "rightScore",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 4
        },
        "reviewerLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "confidence",
        "summary",
        "dimensions",
        "reviewerLabel"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
