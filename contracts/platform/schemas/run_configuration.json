{
  "$ref": "#/definitions/run_configuration",
  "definitions": {
    "run_configuration": {
      "type": "object",
      "properties": {
        "executionRepetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "repeatSafety": {
          "type": "string",
          "const": "read_only"
        },
        "originalService": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "requestTemplate": {
              "type": "object",
              "additionalProperties": {}
            },
            "responseFormat": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ],
              "default": "json"
            },
            "responsePointer": {
              "type": "string",
              "maxLength": 1000,
              "default": ""
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[!#$%&'*+.^_`|~0-9a-zA-Z-]+$"
                  },
                  "env": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                  },
                  "prefix": {
                    "type": "string",
                    "maxLength": 100,
                    "default": ""
                  }
                },
                "required": [
                  "name",
                  "env"
                ],
                "additionalProperties": false
              },
              "maxItems": 32,
              "default": []
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 900000,
              "default": 120000
            }
          },
          "required": [
            "endpoint",
            "requestTemplate"
          ],
          "additionalProperties": false
        },
        "runtimeHarnessTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read_file",
              "glob",
              "list_files",
              "bash"
            ]
          },
          "maxItems": 4
        },
        "runtimeToolConfig": {
          "type": "object",
          "properties": {
            "context": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "string",
                      "object",
                      "array",
                      "number",
                      "boolean"
                    ]
                  },
                  "value": {},
                  "env": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sensitive": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              "default": {}
            },
            "providers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "implementation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "inputs": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^context\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                    }
                  }
                },
                "required": [
                  "implementation",
                  "inputs"
                ],
                "additionalProperties": false
              },
              "default": {}
            },
            "tools": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "contextBindings": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/definitions/run_configuration/properties/runtimeToolConfig/properties/providers/additionalProperties/properties/inputs/additionalProperties"
                    },
                    "default": {}
                  },
                  "authProvider": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "default": {}
            }
          },
          "additionalProperties": false
        },
        "runtimeBindings": {
          "type": "object",
          "properties": {
            "left": {
              "type": "object",
              "properties": {
                "environmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "skillAssetId": {
                  "type": "string",
                  "minLength": 1
                },
                "runtimeInputs": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "maxLength": 8000
                          }
                        },
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "secretEnv": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
                          }
                        },
                        "required": [
                          "secretEnv"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "environmentId",
                "skillAssetId"
              ],
              "additionalProperties": false
            },
            "right": {
              "$ref": "#/definitions/run_configuration/properties/runtimeBindings/properties/left"
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        "runtimeCommandBindings": {
          "type": "object",
          "properties": {
            "left": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "PYTHON",
                      "NODE"
                    ]
                  },
                  "filePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 200,
                    "default": []
                  },
                  "inputSchema": {},
                  "launch": {
                    "type": "object",
                    "properties": {
                      "program": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 100
                      }
                    },
                    "required": [
                      "program",
                      "args"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "path",
                  "kind"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            },
            "right": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "PYTHON",
                      "NODE"
                    ]
                  },
                  "filePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 200,
                    "default": []
                  },
                  "inputSchema": {},
                  "launch": {
                    "type": "object",
                    "properties": {
                      "program": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 100
                      }
                    },
                    "required": [
                      "program",
                      "args"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "path",
                  "kind"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        "runtimeMcpBindings": {
          "type": "object",
          "properties": {
            "left": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "assetDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "toolNames": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "filePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 200
                  },
                  "start": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "prepare": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 100
                  },
                  "environmentReference": {
                    "type": "object",
                    "properties": {
                      "migrationId": {
                        "type": "string",
                        "pattern": "^migration-[a-f0-9-]+$"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "assetDigest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "configurationDigest": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "migrationId",
                      "revision",
                      "assetDigest",
                      "configurationDigest"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "assetDigest",
                  "toolNames",
                  "filePaths",
                  "start"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            },
            "right": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "assetDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "toolNames": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "filePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 200
                  },
                  "start": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "prepare": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "maxItems": 100
                  },
                  "environmentReference": {
                    "$ref": "#/definitions/run_configuration/properties/runtimeMcpBindings/properties/left/items/properties/environmentReference"
                  }
                },
                "required": [
                  "assetDigest",
                  "toolNames",
                  "filePaths",
                  "start"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "preparationId": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "replay"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "direct_model"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "runtime_launcher"
                },
                "environmentId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "environmentId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "judgeMode": {
          "type": "string",
          "enum": [
            "deterministic",
            "model"
          ],
          "default": "deterministic"
        },
        "evaluationMode": {
          "type": "string",
          "enum": [
            "pairwise",
            "candidate_assessment",
            "service_comparison",
            "solution_comparison",
            "candidate_runtime_comparison"
          ],
          "default": "pairwise"
        },
        "skillAssetId": {
          "type": "string",
          "minLength": 1
        },
        "caseSource": {
          "type": "string",
          "enum": [
            "fixed",
            "ai_generated"
          ],
          "default": "fixed"
        },
        "generatedCaseCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 3
        },
        "selectedCaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100,
          "default": []
        },
        "includeHoldout": {
          "type": "boolean",
          "default": false
        },
        "leftVariant": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "without_target_skill"
                },
                "skillId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "mode",
                "skillId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "skill_version"
                },
                "skillId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "mode",
                "skillId",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "rightVariant": {
          "$ref": "#/definitions/run_configuration/properties/leftVariant"
        },
        "executionModel": {
          "type": "object",
          "properties": {
            "providerId": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "credentialRef": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "disabled"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "default": {}
            }
          },
          "required": [
            "providerId",
            "modelId"
          ],
          "additionalProperties": false
        },
        "leftExecutionModel": {
          "$ref": "#/definitions/run_configuration/properties/executionModel"
        },
        "rightExecutionModel": {
          "$ref": "#/definitions/run_configuration/properties/executionModel"
        },
        "judgeModel": {
          "$ref": "#/definitions/run_configuration/properties/executionModel"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 900000,
          "default": 310000
        }
      },
      "required": [
        "runtime"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
