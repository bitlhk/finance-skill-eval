{
  "$ref": "#/definitions/runtime_tool_configuration",
  "definitions": {
    "runtime_tool_configuration": {
      "type": "object",
      "properties": {
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "object",
                  "array",
                  "number",
                  "boolean"
                ]
              },
              "value": {},
              "env": {
                "type": "string",
                "minLength": 1
              },
              "sensitive": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "default": {}
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "implementation": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^context\\.[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                }
              }
            },
            "required": [
              "implementation",
              "inputs"
            ],
            "additionalProperties": false
          },
          "default": {}
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "contextBindings": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/runtime_tool_configuration/properties/providers/additionalProperties/properties/inputs/additionalProperties"
                },
                "default": {}
              },
              "authProvider": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "default": {}
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
