{
  "$ref": "#/definitions/execution_evidence",
  "definitions": {
    "execution_evidence": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed"
          ]
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "skillVersion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "type": "string",
          "maxLength": 131072
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed"
                ]
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 1024,
          "default": []
        },
        "loadedSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "skillId",
              "version"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "usage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "inputTokens": {
                  "type": "number",
                  "minimum": 0
                },
                "outputTokens": {
                  "type": "number",
                  "minimum": 0
                },
                "totalTokens": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtimeIdentityVerified": {
          "type": "boolean"
        },
        "streamCompleted": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "traceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        }
      },
      "required": [
        "runId",
        "side",
        "caseId",
        "status",
        "modelId",
        "skillVersion",
        "output",
        "elapsedMs",
        "runtimeIdentityVerified",
        "streamCompleted",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
