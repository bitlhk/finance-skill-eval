{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.runtime-build-result.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "buildId", "requestId", "requirementsDigest", "status", "builder", "artifact", "runtime", "capabilityResults", "verifications", "errors", "builtAt", "resultDigest"],
  "properties": {
    "schemaVersion": { "const": "finance.runtime-build-result.v1" }, "buildId": { "type": "string", "minLength": 1 }, "requestId": { "type": "string", "minLength": 1 }, "requirementsDigest": { "$ref": "#/$defs/sha256" }, "status": { "enum": ["SUCCEEDED", "PARTIAL", "FAILED", "CANCELLED"] },
    "builder": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "artifact": { "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["mediaType", "uri", "sha256"], "properties": { "mediaType": { "type": "string", "minLength": 1 }, "uri": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "sbomSha256": { "$ref": "#/$defs/sha256" } } }] },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["runtimeType", "version", "protocols", "requiredConfiguration"], "properties": { "runtimeType": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "protocols": { "$ref": "#/$defs/protocols" }, "requiredConfiguration": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "type", "required", "sensitive"], "properties": { "name": { "type": "string", "minLength": 1 }, "type": { "enum": ["string", "number", "boolean"] }, "required": { "type": "boolean" }, "sensitive": { "type": "boolean" } } } } } },
    "capabilityResults": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["requirementId", "status", "verificationIds"], "properties": { "requirementId": { "type": "string", "minLength": 1 }, "status": { "enum": ["IMPLEMENTED", "UNSUPPORTED", "FAILED"] }, "capabilityId": { "type": "string", "minLength": 1 }, "contractDigest": { "$ref": "#/$defs/sha256" }, "verificationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
    "verifications": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "type", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] }, "evidenceSha256": { "$ref": "#/$defs/sha256" } } } },
    "errors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": { "code": { "enum": ["INVALID_REQUIREMENTS", "UNSUPPORTED_SCHEMA_VERSION", "UNSUPPORTED_TARGET_PROTOCOL", "CAPABILITY_UNSUPPORTED", "CONTRACT_INCOMPATIBLE", "BUILD_FAILED", "VERIFICATION_FAILED", "ARTIFACT_UNAVAILABLE", "INTERNAL_ERROR"] }, "requirementId": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "retryable": { "type": "boolean" } } } },
    "builtAt": { "type": "string", "format": "date-time" }, "resultDigest": { "$ref": "#/$defs/sha256" }, "extensions": { "type": "object" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "protocols": { "type": "object", "additionalProperties": false, "required": ["registration", "instance", "execution"], "properties": { "registration": { "type": "string", "minLength": 1 }, "instance": { "type": "string", "minLength": 1 }, "execution": { "type": "string", "minLength": 1 } } } }
}
