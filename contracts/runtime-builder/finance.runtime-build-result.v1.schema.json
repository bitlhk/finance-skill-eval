{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.runtime-build-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildId", "requestId", "requirementsDigest", "status", "builder", "launcher", "capabilityResults", "verifications", "errors", "builtAt", "resultDigest"],
  "properties": {
    "schemaVersion": { "const": "finance.runtime-build-result.v1" },
    "buildId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "requirementsDigest": { "$ref": "finance.runtime-build-result.v1#/$defs/sha256" },
    "status": { "enum": ["SUCCEEDED", "PARTIAL", "FAILED", "CANCELLED"] },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "launcher": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "finance.runtime-launcher-descriptor.v1" }
      ]
    },
    "capabilityResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "status", "verificationIds"],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["IMPLEMENTED", "UNSUPPORTED", "FAILED"] },
          "capabilityId": { "type": "string", "minLength": 1 },
          "contractDigest": { "$ref": "finance.runtime-build-result.v1#/$defs/sha256" },
          "verificationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
          "evidenceSha256": { "$ref": "finance.runtime-build-result.v1#/$defs/sha256" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "enum": ["INVALID_REQUIREMENTS", "UNSUPPORTED_SCHEMA_VERSION", "UNSUPPORTED_TARGET_PROTOCOL", "CAPABILITY_UNSUPPORTED", "CONTRACT_INCOMPATIBLE", "BUILD_FAILED", "VERIFICATION_FAILED", "DEPLOYMENT_FAILED", "LAUNCHER_UNAVAILABLE", "INTERNAL_ERROR"] },
          "requirementId": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" }
        }
      }
    },
    "builtAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "$ref": "finance.runtime-build-result.v1#/$defs/sha256" },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } }, "required": ["status"] },
      "then": { "properties": { "launcher": { "$ref": "finance.runtime-launcher-descriptor.v1" } } },
      "else": { "properties": { "launcher": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
