{
  "schemaVersion": "finance.skill-eval.runtime-capabilities.v1",
  "runtime": {
    "type": "openjiuwen",
    "version": "1.2.0"
  },
  "models": [
    {
      "modelId": "execution",
      "upstreamModelId": "glm-4-plus",
      "label": "GLM 4 Plus"
    }
  ],
  "defaultModelId": "execution",
  "nativeToolNames": [
    "mcp.call"
  ],
  "observability": {
    "schemaVersion": "finance.runtime-observation-capabilities.v1",
    "profile": "tool",
    "supportedKinds": [
      "execution.started",
      "execution.completed",
      "execution.failed",
      "model.call.started",
      "model.call.completed",
      "model.call.failed",
      "tool.call.started",
      "tool.call.completed",
      "tool.call.failed"
    ],
    "nativeEvents": false,
    "replayable": false
  },
  "features": {
    "streaming": true,
    "asyncLaunch": true,
    "packagedMcp": true,
    "externalMcp": false,
    "inlineSecrets": true,
    "multiSkill": true
  },
  "limits": {
    "maxArchiveBytes": 10485760,
    "maxFiles": 500,
    "maxTimeoutMs": 300000,
    "maxConcurrentInstances": 4
  }
}
