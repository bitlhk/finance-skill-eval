{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.runtime-build-requirements.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "target",
    "requiredCapabilities",
    "requirementsDigest",
    "executionRequirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "finance.runtime-build-requirements.v3"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeType",
        "protocols"
      ],
      "properties": {
        "runtimeType": {
          "type": "string",
          "minLength": 1
        },
        "protocols": {
          "$ref": "#/$defs/protocols"
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "hypothesis",
        "evidence"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deploymentId",
            "artifactSha256",
            "capabilitiesDigest"
          ],
          "properties": {
            "deploymentId": {
              "type": "string",
              "minLength": 1
            },
            "artifactSha256": {
              "$ref": "#/$defs/sha256"
            },
            "capabilitiesDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "hypothesis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "issue",
            "expectedBehavior"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "issue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "expectedBehavior": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceRef",
              "summary"
            ],
            "properties": {
              "evidenceRef": {
                "type": "string",
                "minLength": 1
              },
              "probeRef": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "requirementsDigest": {
      "$ref": "#/$defs/sha256"
    },
    "executionRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "features",
        "limits"
      ],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch",
            "isolation"
          ],
          "properties": {
            "os": {
              "enum": [
                "linux",
                "windows",
                "darwin"
              ]
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "isolation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "streaming",
              "packagedMcp",
              "externalMcp",
              "inlineSecrets",
              "multiTurn",
              "toolProcessEvidence",
              "mcpResultChannels",
              "mcpPrepare"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxSkills",
            "maxFiles",
            "maxArchiveBytes",
            "maxTimeoutMs"
          ],
          "properties": {
            "maxSkills": {
              "type": "integer",
              "minimum": 1
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maxArchiveBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxTimeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "instance",
        "execution",
        "observation"
      ],
      "properties": {
        "capabilities": {
          "const": "finance.runtime-capabilities.v1"
        },
        "instance": {
          "const": "finance.runtime-instance.v1"
        },
        "execution": {
          "const": "finance.skill-eval.runtime-case.v1"
        },
        "observation": {
          "const": "finance.runtime-observation.v1"
        }
      }
    },
    "jsonSchema": {
      "type": "object"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "required",
        "reason",
        "contract",
        "constraints",
        "preferredTargetCapability",
        "consumerTools",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputSchema",
            "outputSchema",
            "errorSchema",
            "semantics"
          ],
          "properties": {
            "inputSchema": {
              "$ref": "#/$defs/jsonSchema"
            },
            "outputSchema": {
              "$ref": "#/$defs/jsonSchema"
            },
            "errorSchema": {
              "$ref": "#/$defs/jsonSchema"
            },
            "semantics": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permissions",
            "sideEffects",
            "isolation"
          ],
          "properties": {
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sideEffects": {
              "enum": [
                "none",
                "read",
                "write"
              ]
            },
            "isolation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "preferredTargetCapability": {
          "type": [
            "string",
            "null"
          ]
        },
        "consumerTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "detail"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
