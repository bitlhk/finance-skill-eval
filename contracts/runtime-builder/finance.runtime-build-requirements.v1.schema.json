{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance.runtime-build-requirements.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "source", "target", "requiredCapabilities", "requirementsDigest"],
  "properties": {
    "schemaVersion": { "const": "finance.runtime-build-requirements.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "source": { "type": "object", "additionalProperties": false, "required": ["assetId", "artifactSha256"], "properties": { "assetId": { "type": "string", "minLength": 1 }, "artifactSha256": { "$ref": "#/$defs/sha256" } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["runtimeType", "protocols"], "properties": { "runtimeType": { "type": "string", "minLength": 1 }, "protocols": { "$ref": "#/$defs/protocols" } } },
    "requiredCapabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "requirementsDigest": { "$ref": "#/$defs/sha256" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "instance", "execution", "observation"],
      "properties": {
        "capabilities": { "const": "finance.skill-eval.runtime-capabilities.v1" },
        "instance": { "const": "finance.skill-eval.runtime-instance.v1" },
        "execution": { "const": "finance.skill-eval.runtime-case.v1" },
        "observation": { "const": "finance.runtime-observation.v1" }
      }
    },
    "jsonSchema": { "type": "object" },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "required", "reason", "contract", "constraints", "preferredTargetCapability", "consumerTools", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 },
        "contract": { "type": "object", "additionalProperties": false, "required": ["inputSchema", "outputSchema", "errorSchema", "semantics"], "properties": { "inputSchema": { "$ref": "#/$defs/jsonSchema" }, "outputSchema": { "$ref": "#/$defs/jsonSchema" }, "errorSchema": { "$ref": "#/$defs/jsonSchema" }, "semantics": { "type": "string", "minLength": 1 } } },
        "constraints": { "type": "object", "additionalProperties": false, "required": ["permissions", "sideEffects", "isolation"], "properties": { "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "sideEffects": { "enum": ["none", "read", "write"] }, "isolation": { "type": "string", "minLength": 1 } } },
        "preferredTargetCapability": { "type": ["string", "null"] }, "consumerTools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "line", "detail"], "properties": { "path": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 }, "detail": { "type": "string", "minLength": 1 } } } }
      }
    }
  }
}
