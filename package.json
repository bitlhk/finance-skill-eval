{
  "name": "finance-skill-eval",
  "version": "0.5.1",
  "description": "Enterprise Skill governance, migration, evaluation and optimization platform",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "finance-skill-eval": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "scripts",
    "src/**/*.py",
    "src/resources",
    "integrations/openjiuwen/**/*.py",
    "integrations/openjiuwen/runtime-console-logging.yaml",
    "integrations/openjiuwen/pyproject.toml",
    "integrations/openjiuwen/uv.lock",
    "contracts",
    "docs/2.0/skill-specification.md",
    "packs",
    "README.md"
  ],
  "scripts": {
    "setup:openjiuwen": "node --env-file-if-exists=.env.local scripts/openjiuwen.mjs --setup",
    "check:openjiuwen": "node --env-file-if-exists=.env.local scripts/openjiuwen.mjs --check",
    "python:openjiuwen": "node --env-file-if-exists=.env.local scripts/openjiuwen.mjs",
    "test:python": "node --env-file-if-exists=.env.local scripts/openjiuwen.mjs --test",
    "serve:openjiuwen": "node --env-file-if-exists=.env.local scripts/openjiuwen.mjs --serve",
    "serve:agent-runtime": "node --env-file-if-exists=.env.local scripts/openjiuwen.mjs -m uvicorn integrations.openjiuwen.migration_runtime:app --host 127.0.0.1 --port 56363",
    "pretest": "pnpm build:core",
    "build": "pnpm build:core && pnpm build:web",
    "build:core": "node scripts/build-backend-entry.mjs",
    "build:web": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run && pnpm test:python",
    "test:ui:migration-bundle": "pnpm build && node scripts/verify-native-http.mjs --ui",
    "test:ui:migration-bundle:live": "pnpm build && node scripts/verify-native-http.mjs --ui",
    "test:migration:enterprise:offline": "node scripts/verify-enterprise-examples-offline.mjs",
    "test:skeleton:mcp": "pnpm python:openjiuwen -m unittest tests.test_enterprise_tool_contract tests.test_migration_dependency_contract",
    "serve": "node --env-file-if-exists=.env.local scripts/serve-api.mjs",
    "serve:codex": "node --env-file-if-exists=.env.local scripts/serve-api.mjs --judge-provider=codex_cli",
    "dev": "vite --host 0.0.0.0",
    "eval:investment:replay": "node --env-file-if-exists=.env.local scripts/run-cli.mjs replay --pack packs/finance/investment-research/eval.yaml --out reports/investment-research",
    "eval:wealth:replay": "node --env-file-if-exists=.env.local scripts/run-cli.mjs replay --pack packs/finance/wealth-management/eval.yaml --out reports/wealth-management",
    "pack:local": "pnpm build && pnpm pack --pack-destination artifacts",
    "test:ui:migration": "pnpm build && node scripts/verify-native-http.mjs --ui",
    "test:ui:migration:imports": "pnpm build && node scripts/verify-native-http.mjs --ui",
    "test:ui:migration:live": "pnpm build && node scripts/verify-native-http.mjs --ui",
    "test:ui:migration:builder": "pnpm build && node scripts/verify-native-http.mjs --ui",
    "runtime:check": "node --env-file-if-exists=.env.local scripts/runtime-check.mjs",
    "test:web": "vitest run",
    "test:http": "node scripts/verify-native-http.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "mermaid": "11.12.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-is": "19.1.1",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "remend": "^1.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
