server {
    listen 80;
    listen [::]:80;
    server_name finance-eval.demo.linggan.top;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name finance-eval.demo.linggan.top;
    ssl_certificate /etc/nginx/ssl/demo/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/demo/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 8m;

    location = /__auth_check {
        internal;
        proxy_pass http://127.0.0.1:9528/api/embed/auth-check;
        proxy_set_header Host www.linggan.top;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    location = /api/health {
        proxy_pass http://127.0.0.1:15671;
    }
    location ^~ /api/ {
        auth_request /__auth_check;
        auth_request_set $demo_user $upstream_http_x_studio_user;
        error_page 401 403 = @api_login_required;
        proxy_pass http://127.0.0.1:15671;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Demo-User $demo_user;
        proxy_set_header Authorization "Bearer __INGRESS_TOKEN__";
        proxy_set_header Cookie "";
        proxy_set_header Connection "";
    }
    location / {
        auth_request /__auth_check;
        auth_request_set $demo_user $upstream_http_x_studio_user;
        error_page 401 403 = @sso_bridge;
        proxy_pass http://127.0.0.1:15671;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Demo-User $demo_user;
        proxy_set_header Authorization "Bearer __INGRESS_TOKEN__";
        proxy_set_header Cookie "";
        proxy_set_header Connection "";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location @sso_bridge {
        return 302 https://www.linggan.top/api/embed/sso-bridge?next=$scheme://$host$request_uri;
    }
    location @api_login_required {
        default_type application/json;
        return 401 '{"message":"请登录灵感平台后重新打开评测页面。"}';
    }
}
