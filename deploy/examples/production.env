# dotenv file; parsed as data, never sourced as shell code.
# Linux paths below; Windows and Docker examples override paths explicitly.
FINANCE_EVAL_DATA_DIR=/var/lib/finance-skill-eval/data
FINANCE_RUNTIME_CONFIG=/etc/finance-skill-eval/runtime.json
FINANCE_EVAL_ACCESS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FINANCE_EVAL_HOST=127.0.0.1
FINANCE_EVAL_PORT=56361
FINANCE_RUNTIME_HOST=127.0.0.1
FINANCE_RUNTIME_PORT=56362
FINANCE_EVAL_LOG_LEVEL=info
FINANCE_EVAL_MAX_CONCURRENT_RUNS=1
FINANCE_EVAL_MIN_FREE_MB=1024
FINANCE_EVAL_MODEL_BASE_URL=REPLACE_WITH_OPENAI_COMPATIBLE_BASE_URL
FINANCE_EVAL_MODEL_API_KEY=REPLACE_WITH_MODEL_API_KEY
FINANCE_EVAL_MODEL=REPLACE_WITH_ANALYZER_MODEL_NAME
FINANCE_EVAL_JUDGE_BASE_URL=REPLACE_WITH_OPENAI_COMPATIBLE_BASE_URL
FINANCE_EVAL_JUDGE_API_KEY=REPLACE_WITH_JUDGE_API_KEY
FINANCE_EVAL_JUDGE_MODEL=REPLACE_WITH_JUDGE_MODEL_NAME
FINANCE_EVAL_AGENT_MODEL_ID=enterprise-model
FINANCE_EVAL_AGENT_MAX_ITERATIONS=120
FINANCE_EVAL_AGENT_MAX_TOKENS=32000
FINANCE_EVAL_TRUSTED_LOCAL_SCRIPTS=1
# If model egress requires a proxy, configure it explicitly for the service.
# HTTP_PROXY=http://YOUR_PRIVATE_PROXY:PORT
# HTTPS_PROXY=http://YOUR_PRIVATE_PROXY:PORT
# NO_PROXY=localhost,127.0.0.1,::1
# Full prompts/source diagnostics are deliberately disabled by default.
# Do not set FINANCE_EVAL_AGENT_DUMP in this production profile.
