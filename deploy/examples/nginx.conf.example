# Inside nginx http{}; replace domain/certificates, then run nginx -t.
log_format finance_safe '$time_iso8601 $request_method $uri $status '
                        'request_id=$upstream_http_x_request_id duration=$request_time';
server {
    listen 443 ssl;
    server_name skills.example.internal;
    ssl_certificate /etc/ssl/finance/fullchain.pem;
    ssl_certificate_key /etc/ssl/finance/privkey.pem;
    access_log /var/log/nginx/finance-eval.access.log finance_safe;
    error_log /var/log/nginx/finance-eval.error.log warn;
    client_max_body_size 64m;
    location / {
        proxy_pass http://127.0.0.1:56361;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
