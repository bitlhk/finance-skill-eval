[Unit]
Description=Finance Skill Eval API and migration coordinator
After=network-online.target finance-eval-runtime.service
Wants=network-online.target finance-eval-runtime.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=finance-eval
Group=finance-eval
WorkingDirectory=@PROJECT@
ExecStart=@NODE@ @PROJECT@/deploy/run.mjs api --env @PROJECT@/.env.local
ExecStop=@NODE@ @PROJECT@/deploy/run.mjs stop api --env @PROJECT@/.env.local
Environment=HOME=/var/lib/finance-skill-eval
Environment=UV_CACHE_DIR=/var/cache/finance-skill-eval
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
KillMode=control-group
TimeoutStopSec=75
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-eval-api

[Install]
WantedBy=multi-user.target
