[Unit]
Description=Finance Skill Eval OpenJiuwen Runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=finance-eval
Group=finance-eval
WorkingDirectory=/opt/finance-skill-eval/current
ExecStart=@NODE@ /opt/finance-skill-eval/current/deploy/run.mjs runtime --env /etc/finance-skill-eval/production.env
ExecStop=@NODE@ /opt/finance-skill-eval/current/deploy/run.mjs stop runtime --env /etc/finance-skill-eval/production.env
Environment=HOME=/var/lib/finance-skill-eval
Environment=UV_CACHE_DIR=/var/cache/finance-skill-eval
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
KillMode=control-group
TimeoutStopSec=75
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-eval-runtime

[Install]
WantedBy=multi-user.target
